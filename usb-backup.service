[Unit]
Description=USB Backup Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-backup-runner.sh
# Oneshot services have no start timeout by default, so a hung network mount
# would block every later run. Raise this if the first full copy needs longer.
TimeoutStartSec=12h
